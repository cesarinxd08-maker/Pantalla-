
-- EPIC LOADING SCREEN | Roblox Studio
-- Inspirado en Steal a Brainrot
-- Coloca este LocalScript en ReplicatedFirst

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedFirst = game:GetService("ReplicatedFirst")

ReplicatedFirst:RemoveDefaultLoadingScreen()

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- CONFIGURACION
local LOAD_TIME = 7
local RED = Color3.fromRGB(255, 35, 55)
local BLACK = Color3.fromRGB(10, 10, 14)
local WHITE = Color3.fromRGB(255, 255, 255)

-- PANTALLA PRINCIPAL
local gui = Instance.new("ScreenGui")
gui.Name = "EpicLoadingScreen"
gui.IgnoreGuiInset = true
gui.ResetOnSpawn = false
gui.DisplayOrder = 999
gui.Parent = playerGui

local background = Instance.new("Frame")
background.Size = UDim2.fromScale(1, 1)
background.BackgroundColor3 = BLACK
background.BorderSizePixel = 0
background.Parent = gui

-- Degradado rojo y negro
local gradient = Instance.new("UIGradient")
gradient.Color = ColorSequence.new({
    ColorSequenceKeypoint.new(0, Color3.fromRGB(35, 0, 5)),
    ColorSequenceKeypoint.new(0.5, BLACK),
    ColorSequenceKeypoint.new(1, Color3.fromRGB(60, 0, 10))
})
gradient.Rotation = 35
gradient.Parent = background

-- Lineas decorativas
local stripe = Instance.new("Frame")
stripe.Size = UDim2.new(1.5, 0, 0, 3)
stripe.Position = UDim2.fromScale(-0.2, 0.18)
stripe.Rotation = -12
stripe.BackgroundColor3 = RED
stripe.BackgroundTransparency = 0.35
stripe.BorderSizePixel = 0
stripe.Parent = background

-- TITULO
local title = Instance.new("TextLabel")
title.Size = UDim2.new(0.9, 0, 0, 65)
title.Position = UDim2.new(0.05, 0, 0.29, 0)
title.BackgroundTransparency = 1
title.Text = "STEAL A BRAINROT"
title.TextColor3 = WHITE
title.TextScaled = true
title.Font = Enum.Font.GothamBlack
title.Parent = background

local titleStroke = Instance.new("UIStroke")
titleStroke.Color = RED
titleStroke.Thickness = 1.5
titleStroke.Parent = title

-- SUBTITULO
local subtitle = Instance.new("TextLabel")
subtitle.Size = UDim2.new(0.9, 0, 0, 30)
subtitle.Position = UDim2.new(0.05, 0, 0.39, 0)
subtitle.BackgroundTransparency = 1
subtitle.Text = "PREPARATE PARA EL CAOS"
subtitle.TextColor3 = RED
subtitle.TextScaled = true
subtitle.Font = Enum.Font.GothamBold
subtitle.Parent = background

-- CONTENEDOR DE LA BARRA
local barBack = Instance.new("Frame")
barBack.Size = UDim2.new(0.72, 0, 0, 18)
barBack.Position = UDim2.new(0.14, 0, 0.57, 0)
barBack.BackgroundColor3 = Color3.fromRGB(40, 40, 48)
barBack.BorderSizePixel = 0
barBack.ClipsDescendants = true
barBack.Parent = background

local barCorner = Instance.new("UICorner")
barCorner.CornerRadius = UDim.new(0, 9)
barCorner.Parent = barBack

-- PROGRESO
local fill = Instance.new("Frame")
fill.Size = UDim2.fromScale(0, 1)
fill.BackgroundColor3 = RED
fill.BorderSizePixel = 0
fill.Parent = barBack

local fillCorner = Instance.new("UICorner")
fillCorner.CornerRadius = UDim.new(0, 9)
fillCorner.Parent = fill

local fillGradient = Instance.new("UIGradient")
fillGradient.Color = ColorSequence.new({
    ColorSequenceKeypoint.new(0, Color3.fromRGB(150, 0, 15)),
    ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 65, 75))
})
fillGradient.Parent = fill

-- PORCENTAJE
local percent = Instance.new("TextLabel")
percent.Size = UDim2.new(0.5, 0, 0, 35)
percent.Position = UDim2.new(0.25, 0, 0.61, 0)
percent.BackgroundTransparency = 1
percent.Text = "0%"
percent.TextColor3 = WHITE
percent.TextScaled = true
percent.Font = Enum.Font.GothamBlack
percent.Parent = background

-- ESTADO
local status = Instance.new("TextLabel")
status.Size = UDim2.new(0.9, 0, 0, 25)
status.Position = UDim2.new(0.05, 0, 0.69, 0)
status.BackgroundTransparency = 1
status.Text = "INICIANDO..."
status.TextColor3 = Color3.fromRGB(180, 180, 190)
status.TextScaled = true
status.Font = Enum.Font.GothamMedium
status.Parent = background

-- ANIMACION DE CARGA
local messages = {
    {0, "INICIANDO..."},
    {25, "CARGANDO EL UNIVERSO..."},
    {50, "PREPARANDO LOS BRAINROTS..."},
    {75, "CASI LISTO..."},
    {100, "¡BIENVENIDO AL CAOS!"}
}

local startTime = os.clock()

while true do
    local elapsed = os.clock() - startTime
    local progress = math.clamp(elapsed / LOAD_TIME, 0, 1)
    local value = math.floor(progress * 100)

    fill.Size = UDim2.fromScale(progress, 1)
    percent.Text = value .. "%"

    for _, message in ipairs(messages) do
        if value >= message[1] then
            status.Text = message[2]
        end
    end

    if progress >= 1 then
        break
    end

    task.wait(0.04)
end

-- FINALIZACION
task.wait(0.5)

local fadeInfo = TweenInfo.new(
    0.8,
    Enum.EasingStyle.Quad,
    Enum.EasingDirection.Out
)

for _, obj in ipairs(gui:GetDescendants()) do
    if obj:IsA("TextLabel") then
        TweenService:Create(
            obj, fadeInfo, {TextTransparency = 1}
        ):Play()
    elseif obj:IsA("Frame") then
        TweenService:Create(
            obj, fadeInfo, {BackgroundTransparency = 1}
        ):Play()
    elseif obj:IsA("UIStroke") then
        TweenService:Create(
            obj, fadeInfo, {Transparency = 1}
        ):Play()
    end
end

TweenService:Create(
    background, fadeInfo, {BackgroundTransparency = 1}
):Play()

task.wait(1)
gui:Destroy()
